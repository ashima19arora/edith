# Copy to .env.local and fill in. Never commit .env.local.
# The app runs without these: sign-in falls back to guest mode.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio. Server-side only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=
