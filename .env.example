# Copy to .env.local and fill in. Never commit .env.local.
# The app runs without these: sign-in falls back to guest mode.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio: mission picks, bill photos and typed questions to EDITH. Server-side only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional backups, tried in order when a key hits its limit. Add _4, _5 and so on with no gaps.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=

# Google Cloud, with the Routes API enabled. Optional: without it, distances are estimated.
# Server-side only: never prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=
